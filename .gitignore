# Dependencias PHP (composer install las regenera)
/vendor/
composer.lock

# Configuración con credenciales reales — nunca versionar.
# Cada uno tiene su .example al lado con las claves vacías.
inc/config/*.local.php

# Archivos privados servidos con control de acceso (carnets, verificación DNI/selfie).
# Se versiona .htaccess para que el deny exista en el hosting; el resto son uploads.
inc/storage/**
!inc/storage/
!inc/storage/.htaccess
!inc/storage/verificacion/
!inc/storage/verificacion/.htaccess
!inc/storage/carnets/
!inc/storage/carnets/.htaccess


# Archivos subidos por usuarios (avatares, fotos de mascotas, publicaciones, productos)
uploads/

# Node / Expo
node_modules/
app-movil/node_modules/
app-movil/.expo/
app-movil/dist/
app-movil/android/
app-movil/ios/
.env
.env.local

# Sistema
Thumbs.db
.DS_Store

# Cursor / Claude local
.claude/


# Credenciales DB (mismo criterio que BitFlow)
inc/funciones/bd.php


# Assets del export web de Expo (rutas bajo assets/node_modules)
!assets/
!assets/node_modules/
!assets/node_modules/**

