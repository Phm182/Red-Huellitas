Options -Indexes
DirectoryIndex index.html

# MapLibre v6 worker (ESM): sin el MIME correcto el navegador no lo ejecuta
# y el mapa queda en blanco.
<IfModule mod_mime.c>
    AddType text/javascript .mjs
</IfModule>

# El HTML siempre fresco: apunta a un entry-*.js hasheado. Si se cachea el
# index, el sitio queda clavado en un bundle viejo aunque el pull haya traído
# archivos nuevos.
<IfModule mod_headers.c>
    <FilesMatch "^(index\.html)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
    </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # No reescribir API PHP, uploads, logos ni assets del build
    RewriteRule ^(inc|uploads|imgLogo|vendor|sql|_expo|assets)/ - [L]
    RewriteRule ^(favicon\.ico|metadata\.json|maplibre-gl-worker\.mjs|maplibre-gl-shared\.mjs)$ - [L]

    # SPA: rutas de Expo Router → index.html
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_authz_core.c>
    <FilesMatch "(^\.|\.env|\.ini|\.log|\.sql|\.bak|\.dist)$">
        Require all denied
    </FilesMatch>
</IfModule>

<IfModule !mod_authz_core.c>
    <FilesMatch "(^\.|\.env|\.ini|\.log|\.sql|\.bak|\.dist)$">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>
