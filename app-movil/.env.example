# URL base del backend PHP (sin barra final), apuntando a la carpeta inc/.
# Web en el mismo subdominio (producción): /inc
# Local Expo Go / emulador: http://localhost/Red%20Huellitas/inc
# Dispositivo físico: IP LAN (ej: http://192.168.0.10/Red%20Huellitas/inc)
EXPO_PUBLIC_API_URL=/inc

# Client IDs de Google OAuth (Google Cloud Console) para expo-auth-session
EXPO_PUBLIC_GOOGLE_CLIENT_ID_WEB=
EXPO_PUBLIC_GOOGLE_CLIENT_ID_ANDROID=
EXPO_PUBLIC_GOOGLE_CLIENT_ID_IOS=
