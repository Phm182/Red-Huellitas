# Local / Expo Go (emulador o dispositivo en la misma red)
EXPO_PUBLIC_API_URL=http://localhost/Red%20Huellitas/inc

# Web en el mismo subdominio (export web):
# EXPO_PUBLIC_API_URL=/inc

# APK / build nativo (obligatorio URL absoluta del hosting):
# EXPO_PUBLIC_API_URL=https://redhuellitas.bitflow.com.ar

# Obligatorio en nativo (Android/iOS): el fetch propio de Expo ("winter") no
# soporta el formato {uri,name,type} que usa toda subida de archivo de la app
# (src/utils/upload.ts). Sin esto, publicar cualquier cosa con foto/video
# falla con "No se pudo conectar" en vez de subir.
EXPO_PUBLIC_USE_RN_FETCH=1

# Client IDs de Google OAuth (Google Cloud Console)
EXPO_PUBLIC_GOOGLE_CLIENT_ID_WEB=
EXPO_PUBLIC_GOOGLE_CLIENT_ID_ANDROID=
EXPO_PUBLIC_GOOGLE_CLIENT_ID_IOS=
# Opcional: forzar redirect web (debe coincidir con Google Cloud)
# EXPO_PUBLIC_GOOGLE_REDIRECT_URI=http://localhost:8081
