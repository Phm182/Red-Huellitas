{
  "expo": {
    "name": "Red Huellitas",
    "slug": "red-huellitas",
    "version": "1.0.0",
    "scheme": "redhuellitas",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.redhuellitas.app"
    },
    "android": {
      "package": "com.redhuellitas.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#E8873A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA",
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO",
        "RECORD_AUDIO",
        "POST_NOTIFICATIONS",
        "VIBRATE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "redhuellitas"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Red Huellitas usa tu ubicación para mostrar tu zona a otros usuarios y encontrar mascotas/servicios cercanos."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Red Huellitas necesita acceso a tus fotos para subir imágenes de perfil y verificación.",
          "cameraPermission": "Red Huellitas necesita acceso a tu cámara para tomar fotos de verificación y perfil."
        }
      ],
      "expo-video",
      "expo-system-ui",
      [
        "expo-notifications",
        {
          "color": "#E8873A"
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
