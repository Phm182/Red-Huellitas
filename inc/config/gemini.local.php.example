/**
 * Copiar este archivo a gemini.local.php (gitignored) y completar la API key.
 *
 * La key se saca de Google AI Studio (https://aistudio.google.com): es gratis,
 * no pide tarjeta, y el modelo de imagen da ~500 generaciones por día.
 *
 * Sin este archivo — o con la key vacía — la generación de avatares queda
 * DESACTIVADA en silencio: el minijuego sigue funcionando y mostrando la foto
 * real de la mascota. Mismo criterio que Mercado Pago y el email.
 */
return [
    'GEMINI_API_KEY' => '',

    // Endpoint y modelo configurables a propósito: Google está migrando a un
    // endpoint nuevo (/v1beta/interactions) con otro formato de request. Si
    // cambia, se ajusta acá sin tocar código. El {modelo} se reemplaza solo.
    'GEMINI_ENDPOINT' => 'https://generativelanguage.googleapis.com/v1beta/models/{modelo}:generateContent',
    // Avatar img2img. Si tu key no tiene cuota en este modelo, probá
    // gemini-3.1-flash-image o el que liste ListModels.
    'GEMINI_MODELO'   => 'gemini-3.1-flash-image',

    // Modelo multimodal de texto (OCR DNI + face match). No uses el de imagen.
    // gemini-2.5-flash dejó de aceptar keys nuevas ("no longer available to new users").
    'GEMINI_MODELO_TEXTO' => 'gemini-3.5-flash',

    // Filtro NSFW al subir fotos públicas (true = activo si hay API key).
    'MEDIA_MODERACION_ACTIVA' => true,

    // Umbrales 0–1 para auto-aprobar / auto-rechazar verificación de cuenta.
    'VERIF_UMBRAL_APROBAR'  => 0.78,
    'VERIF_UMBRAL_RECHAZAR' => 0.40,

    // Modelos de texto de respaldo si el principal falla (404/cuota).
    'GEMINI_MODELO_TEXTO_FALLBACKS' => [
        'gemini-2.5-flash',
        'gemini-2.0-flash',
        'gemini-2.0-flash-lite',
        'gemini-flash-latest',
    ],

    // Token para el cron de reintentos de verificación:
    // /inc/ajax/cron/verificacion_reintentar.php?token=...
    'CRON_VERIFICACION_TOKEN' => '',

    // Topes propios, por debajo de la cuota gratuita real (~500/día), para que
    // un solo usuario no se coma el cupo de todos.
    'LIMITE_DIARIO_USUARIO' => 3,
    'LIMITE_DIARIO_GLOBAL'  => 400,
];
