    // Endpoint relativo para confronto facial (ajustá al contrato real)
    'KYC_ENDPOINT_FACIAL' => '/api/v1/validacion/facial',

    // Umbral 0–1 para aprobar con Renaper (suele venir 0–100 en la API)
    'KYC_UMBRAL_FACE' => 0.85,

    'KYC_TIMEOUT_SEGUNDOS' => 45,
];
