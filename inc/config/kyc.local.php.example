    // true = intentar Renaper/SID después del análisis Gemini
    'KYC_HABILITADO' => false,

    // 'renaper_sid' = API propia del Estado | 'http_generico' = intermediario
    'KYC_PROVEEDOR' => 'renaper_sid',

    'KYC_BASE_URL' => 'https://ejemplo-sid.renaper.gob.ar',
    'KYC_API_KEY'  => '',
    'KYC_CLIENT_ID' => '',
